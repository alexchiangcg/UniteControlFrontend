    "definitions": {
        "viewmodels.ResetPasswordRequest": {
            "type": "object",
            "required": [
                "password",
                "token"
            ],
            "properties": {
                "password": {
                    "type": "string"
                },
                "token": {
                    "type": "string"
                }
            }
        },
        "viewmodels.ResponseData": {
            "type": "object",
            "properties": {
                "data": {},
                "error_code": {
                    "type": "string"
                },
                "error_message": {
                    "type": "string"
                }
            }
        },
        "viewmodels.SendResetPasswordEmailRequest": {
            "type": "object",
            "required": [
                "account",
                "email"
            ],
            "properties": {
                "account": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                }
            }
        },
        "viewmodels.UserLoginRequest": {
            "type": "object",
            "required": [
                "account",
                "password"
            ],
            "properties": {
                "account": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "viewmodels.UserRegisterData": {
            "type": "object",
            "required": [
                "account"
            ],
            "properties": {
                "account": {
                    "type": "string",
                    "maxLength": 32
                },
                "email": {
                    "type": "string"
                }
            }
        },
        "viewmodels.UserRegisterRequest": {
            "type": "object",
            "required": [
                "users"
            ],
            "properties": {
                "users": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/viewmodels.UserRegisterData"
                    }
                }
            }
        }
    }
